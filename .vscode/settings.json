{
  "actionButtons": {
    "commands": [
      {
        "name": "Build debug",
        "command": ".\\build.bat debug",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      },
      {
        "name": "Build release",
        "command": ".\\build.bat release",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      },
      {
        "name": "Build debug tracy",
        "command": ".\\build.bat debug tracy",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      },
      {
        "name": "Build debug (flyff UI)",
        "command": ".\\build.bat debug flyff",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      },
      {
        "name": "Build release (flyff UI)",
        "command": ".\\build.bat release flyff",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      },
      {
        "name": "Build debug tracy (flyff UI)",
        "command": ".\\build.bat debug flyff tracy",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      },
      {
        "name": "Sync build hash to server",
        "command": ".\\set-lb-hash.bat",
        "cwd": "${workspaceFolder}",
        "singleInstance": true,
      }
    ],
    "defaultColor": "white",
    "reloadButton": "↻",
    "loadNpmCommands": false
  },
  "editor.rulers": [
    120
  ]
}